{
  "id": "/app",
  "name": "OpenBot",
  "short_name": "OpenBot",
  "description": "Run Codex and Claude side by side as persistent AI teammates, each with its own workspace, queue, and context.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "launch_handler": { "client_mode": "navigate-existing" },
  "prefer_related_applications": false,
  "background_color": "#1a1a1a",
  "theme_color": "#1a1a1a",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open the app",
      "short_name": "Open",
      "url": "/app",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Connect a computer",
      "short_name": "Connect",
      "url": "/app?connect=1",
      "icons": [{ "src": "/icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
